# Copy to apps/api/.env. This template has no credentials or invented prices.
# npm run dev:api loads this workspace-local file; existing process env wins.
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PERSISTENCE_MODE=memory
TOKEN_SIGNING_SECRET=
MAX_REPLICAS=1
MAX_CONCURRENT_SESSIONS=1
EMERGENCY_STOP=false

# Production requires Cosmos, a 32+ character signing secret and one replica.
# The pre-provisioned container must partition on /id with TTL enabled.
COSMOS_ENDPOINT=
COSMOS_DATABASE=car-demo
COSMOS_CONTAINER=records
COSMOS_KEY=

# Enable only with deployment-verified server credentials and a real rate card.
# Managed identity is preferred; never expose API keys in browser configuration.
VOICE_LIVE_ENDPOINT=
VOICE_LIVE_REGION=
VOICE_LIVE_API_KEY=
VOICE_LIVE_USE_MANAGED_IDENTITY=false
# Enable only after verifying /calls preview, control-channel usage/tools and
# upstream WebSocket closure terminating RTP on this specific target resource.
VOICE_LIVE_WEBRTC_VERIFIED=false
VOICE_RATE_CARD_JSON=

# Native GPT-Live uses its separate WebSocket protocol and Entra authentication.
# Endpoint is the Azure OpenAI resource root; deployment must be gpt-live-1.
# Rate card: version, source (HTTPS), effectiveAt (ISO UTC), usdPerHour,
# reservationUsd (must cover the entire 600-second session, maximum $2).
GPT_LIVE_ENDPOINT=
GPT_LIVE_DEPLOYMENT=
GPT_LIVE_REGION=
GPT_LIVE_DEPLOYMENT_VERIFIED=false
GPT_LIVE_RATE_CARD_JSON=
# Optional managed Responses tools; deployment must be gpt-6.1-sol on the
# GPT-Live resource. No silent fallback. Rate JSON: deployment, inputText,
# outputText (USD/million tokens), maxResponseTokens, rateVersion,
# source (official HTTPS pricing evidence) and effectiveAt (ISO timestamp).
GPT_LIVE_RESPONSES_DELEGATION_VERIFIED=false
GPT_LIVE_RESPONSES_RATE_CARD_JSON=

# Explicit Azure Speech -> gpt-6.1-sol Responses -> Azure Speech cascade.
# Resource root endpoint, not a deployment-specific chat-completions URL.
# Rate card: version, source, effectiveAt, inputText/outputText (USD/million
# tokens), sttUsdPerHour, ttsUsdPerMillionCharacters, reservationUsd,
# maxResponseTokens. All prices must match the actual deployed services.
CASCADE_SPEECH_REGION=
CASCADE_SPEECH_KEY=
CASCADE_RESPONSES_ENDPOINT=
CASCADE_RESPONSES_KEY=
CASCADE_DEPLOYMENT=
CASCADE_DEPLOYMENT_VERIFIED=false
CASCADE_RATE_CARD_JSON=

# Real Maps requests require a verified positive per-request USD estimate.
AZURE_MAPS_KEY=
AZURE_MAPS_REQUEST_USD=

# Official Web IQ MCP endpoint/auth are documented, but video tool schemas and
# pricing still require authenticated discovery and verification.
# Do not set WEB_IQ_CONTRACT merely because an endpoint/key is available.
WEB_IQ_ENDPOINT=https://api.microsoft.ai/v3/mcp
WEB_IQ_API_KEY=
WEB_IQ_AUTH_HEADER=x-apikey
WEB_IQ_CONTRACT=
WEB_IQ_VERIFICATION_URL=
WEB_IQ_REQUEST_USD=

# Responses-mediated Web IQ search. Only explicitly reviewed read-only tools.
# Deployment must be gpt-6.1-sol. This is separate from the native voice model.
# Rate card: version, source, effectiveAt, inputText/outputText (USD/million
# tokens), mcpRequestUsd, reservationUsd, maxOutputTokens.
WEB_IQ_RESPONSES_ENDPOINT=
WEB_IQ_RESPONSES_KEY=
WEB_IQ_RESPONSES_DEPLOYMENT=
WEB_IQ_READONLY_TOOLS_JSON=
WEB_IQ_SEARCH_VERIFIED=false
WEB_IQ_SEARCH_RATE_CARD_JSON=

# Optional administrator access uses Entra JWT issuer/audience/role validation.
ADMIN_TENANT_ID=
ADMIN_AUDIENCE=
ADMIN_ROLE=Lead.Admin
ADMIN_CLIENT_ID=
ADMIN_SCOPE=

# Optional provisional Azure costs, not a final invoice or visitor attribution.
# Example: /subscriptions/<subscription-id>/resourceGroups/<resource-group>
# Grant Cost Management Reader at this scope to the backend managed identity.
AZURE_COST_SCOPE=

# Spotify is external-link-only. There are no enabled Spotify OAuth/SDK settings.
