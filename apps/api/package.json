{
  "name": "@car/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --alias:@car/contracts=../../packages/contracts/src/index.ts --outdir=dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/cosmos": "^4.5.0",
    "@azure/identity": "^4.11.0",
    "@car/contracts": "0.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5"
  }
}
